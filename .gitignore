# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.vite/
*.tsbuildinfo
# Vite output. `app/inertia.py` reads the manifest from here; the whole
# directory is generated by `npm run build`.
/static/build/

*.log
npm-debug.log*

# ---------------------------------------------------------------------------
# Runtime state
#
# Written by a running instance, not by a developer. None of it is portable
# between machines and some of it is customer data.
# ---------------------------------------------------------------------------

# SQLite, plus the write-ahead log and shared-memory sidecars that appear
# beside it. Ignoring only `*.db` leaves those two behind as noise.
*.db
*.db-shm
*.db-wal
*.sqlite3

# The collector's byte offset into each gateway's access log.
/storage/collector-*.json
# Access logs Caddy writes and Janus ingests.
/storage/*.log
/storage/exports/*
!/storage/exports/.gitkeep

# ---------------------------------------------------------------------------
# Secrets
#
# Every setting comes from the environment, so a local `.env` is the one file
# that holds real credentials. It must never be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# The CLI's stored bearer token, if JANUS_HOME is pointed at the checkout.
credentials.json

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~

# Rotated Caddy access logs written at runtime (not portable, contains client IPs)
*.gz
/storage/access-*
