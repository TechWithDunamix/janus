[Unit]
Description=Janus — apply database migrations and seed the RBAC catalogue
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=janus.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=janus
Group=janus
WorkingDirectory=/opt/janus
EnvironmentFile=/etc/janus/janus.env
Environment=DB_GENERATE_SCHEMAS=true
ExecStart=/opt/janus/.venv/bin/janus migrate

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/janus/storage
