# /etc/janus/janus.env  —  read by every janus-*.service unit (EnvironmentFile=).
# install.sh writes this on first run and generates SECRET_KEY. Edit it and
# `systemctl restart janus.target` to apply. Full reference: app/config.py.

# ---- Application --------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://janus.example.com
SECRET_KEY=__REPLACE_ME__            # openssl rand -hex 32
CORS_ORIGINS=https://janus.example.com
COOKIE_SECURE=true

# ---- Web tier --------------------------------------------------------
JANUS_HOST=127.0.0.1
JANUS_PORT=8000
JANUS_WEB_WORKERS=2

# ---- Database --------------------------------------------------------
# install.sh --postgres sets this to the local DB it creates.
DATABASE_URL=postgres://janus:janus@127.0.0.1:5432/janus
DB_GENERATE_SCHEMAS=false            # only janus-migrate.service creates schema

# ---- Job queue --------------------------------------------------------
# redis: the worker and the scheduler share the queue (recommended).
# memory: single-process only — run just janus-scheduler, not janus-worker.
QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
JANUS_WORKER_QUEUES=collector,health,gateway,analytics
JANUS_WORKER_CONCURRENCY=4

# ---- Caddy data plane ------------------------------------------------
# Janus never proxies traffic; this is the admin API it drives. Caddy exposes
# it on localhost:2019 by default.
CADDY_ADMIN_URL=http://127.0.0.1:2019
CADDY_METRICS_URL=http://127.0.0.1:2019/metrics
CADDY_SIMULATE=false
# CADDY_SERVER_NAME=janus
# CADDY_LISTEN=:8080
CADDY_ACCESS_LOG=/opt/janus/storage/access.log

# ---- Front end -----------------------------------------------------
VITE_DEV=false
