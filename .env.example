# Janus configuration.
#
# Every setting has a working default; a laptop needs none of them. This file
# documents the ones a real deployment will want to set. Copy to `.env` and
# edit — `.env` is gitignored.

# ---- Application ----------------------------------------------------------
APP_NAME=Janus
APP_ENV=production
APP_URL=https://janus.example.com
APP_DEBUG=false

# Sign sessions and CSRF tokens. Janus refuses to start in production with the
# development default. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# On when Janus is reached over HTTPS. A `Secure` cookie on plain HTTP is
# accepted by the browser and then never sent back, which reads as "login
# silently does nothing".
COOKIE_SECURE=true

# ---- Database -------------------------------------------------------------
# SQLite on a laptop, Postgres in a container. Every column is portable.
DATABASE_URL=postgres://janus:janus@postgres:5432/janus
# Off on workers and the scheduler: only one process should own the schema.
DB_GENERATE_SCHEMAS=true

# ---- Caddy ----------------------------------------------------------------
# The admin API of the Caddy instance Janus manages.
CADDY_ADMIN_URL=http://caddy:2019
# The server object inside Caddy that Janus owns. Janus never writes anything
# else, so a Caddy carrying other servers keeps them.
CADDY_SERVER_NAME=janus
# Where Caddy writes the JSON access log Janus ingests. Must be readable by
# the Janus process — a shared volume when they are separate containers.
CADDY_ACCESS_LOG=/var/log/caddy/janus-access.log
# Off by default; set to true only where there is genuinely no Caddy (CI, or a
# laptop without the binary). Janus refuses to start with it on in production.
CADDY_SIMULATE=false

# ---- Queue ----------------------------------------------------------------
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# ---- Analytics ------------------------------------------------------------
# Request rows answer per-client questions and are large; rollups answer every
# chart and are three orders of magnitude smaller. Hence two retentions.
REQUEST_RETENTION_HOURS=168
ROLLUP_RETENTION_DAYS=90

# What counts as "bad" is deployment-specific: an internal batch API and a
# public checkout do not share a definition.
ERROR_RATE_CRITICAL=0.05
LATENCY_P95_CRITICAL_MS=1000
